<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dexter_background"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/dexter_on_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="16 Architecture Segments"
                android:textColor="@color/dexter_on_background"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSummarySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All SQLite tables · 100% On-Device"
                android:textColor="@color/dexter_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalDbSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_rounded"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="WAL Mode"
            android:textColor="@color/dexter_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Explanatory Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_surface_rounded"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Why 16 Segments Are Not on the Bottom Bar"
            android:textColor="@color/dexter_on_background"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="A standard bottom bar can only fit 4–5 buttons before overlapping. Dexter provides this dedicated hub and a dedicated page for every segment so you can inspect all live rows, schemas, and counts."
            android:textColor="@color/dexter_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Filter Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/categoryChipsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="All (16)"
                android:textColor="@color/dexter_on_background"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipProductivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="Productivity (4)"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipLife"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="Life &amp; Health (4)"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipIntelligence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="Intelligence (3)"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="System &amp; Audit (5)"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Segments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSegments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp" />

</LinearLayout>
