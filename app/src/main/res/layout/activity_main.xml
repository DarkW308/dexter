<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dexter_background">

    <!-- Top Status Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="DEXTER"
            android:textColor="@color/dexter_on_background"
            android:textSize="22sp" />

        <!-- Service Status Dot & Label (🟢 Live / 🟡 Degraded / 🔴 Offline) -->
        <LinearLayout
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_rounded"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_live" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:text="Live"
                android:textColor="@color/status_live"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Avatar Button -->
        <FrameLayout
            android:id="@+id/btnProfileAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_surface_rounded"
            android:clickable="true"
            android:contentDescription="Profile and Preferences"
            android:focusable="true">

            <TextView
                android:id="@+id/tvProfileAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🤖"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Center Container: Voice Orb & Dynamic Hint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <com.aistudio.dexter.ui.view.VoiceOrbView
                    android:id="@+id/voiceOrbView"
                    android:layout_width="170dp"
                    android:layout_height="170dp" />

                <TextView
                    android:id="@+id/orbHintText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tap orb to speak or type command below"
                    android:textColor="@color/dexter_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Inline Dexter Response Feedback Card -->
            <LinearLayout
                android:id="@+id/responseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/dexter_primary" />

                <TextView
                    android:id="@+id/responseText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="👋 Hi! I'm Dexter, your offline AI assistant. Speak, type below, or tap any prompt to test."
                    android:textColor="@color/dexter_on_background"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Inline Interactive Command Input Bar -->
            <LinearLayout
                android:id="@+id/commandBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_surface_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp">

                <EditText
                    android:id="@+id/inputHomeCommand"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Type a command (e.g. spent 45 on travel)..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/dexter_on_background"
                    android:textColorHint="@color/dexter_on_surface_variant"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnHomeMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voice Input"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/dexter_primary" />

                <ImageButton
                    android:id="@+id/btnHomeSend"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send Command"
                    android:src="@drawable/ic_send"
                    app:tint="@color/dexter_primary" />
            </LinearLayout>

            <!-- Quick Suggestion Action Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <TextView
                        android:id="@+id/chipSampleExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_surface_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="☕ spent 45 on travel"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipSampleTask"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_surface_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="📋 add task Review design"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipSampleAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_surface_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="⏰ remind me at 5 PM"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipSampleBriefing"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_surface_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="🌅 daily briefing"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipSampleBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_surface_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="💰 summarize expenses"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Alexa Hands-Free Assistant & Proactive Wake-Up Card -->
            <LinearLayout
                android:id="@+id/cardAlexaMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎙️ Offline Wake-Word (ONNX)"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alexaStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_rounded"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="🟢 Active"
                        android:textColor="@color/status_live"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/alexaDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Say &quot;Hey Dexter&quot;, &quot;Dexter&quot;, or &quot;buddy&quot; hands-free (Offline ONNX). Includes autonomous morning briefing &amp; wake-up interaction with escalating follow-up if you stay in bed."
                    android:textColor="@color/dexter_on_surface_variant"
                    android:textSize="13sp" />

                <!-- Action Buttons: Test Wake-Up Follow-up & Voice Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSimulateWakeUp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/dexter_primary"
                        android:text="⚡ Test Wake-Up Follow-Up"
                        android:textColor="@color/dexter_on_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnToggleAlexaVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/dexter_surface_variant"
                        android:text="Disable"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Today's Briefing Summary Card -->
            <LinearLayout
                android:id="@+id/cardBriefing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌅 Today's Briefing"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="@color/dexter_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/briefingMetricsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Loading daily briefing..."
                    android:textColor="@color/dexter_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/dexter_surface_variant" />

                <!-- Next Priority Task -->
                <TextView
                    android:id="@+id/nextTaskText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="📋 Next: No pending tasks"
                    android:textColor="@color/dexter_on_surface"
                    android:textSize="14sp" />

                <!-- Next Alarm / Reminder -->
                <TextView
                    android:id="@+id/nextAlarmText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="⏰ Next: No upcoming alarms"
                    android:textColor="@color/dexter_on_surface"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 16 Database Segments Hub Card -->
            <LinearLayout
                android:id="@+id/cardSegmentsHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📦 All 16 Architecture Segments"
                        android:textColor="@color/dexter_on_background"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_rounded"
                        android:paddingLeft="8dp"
                        android:paddingTop="3dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="3dp"
                        android:text="16 Domains"
                        android:textColor="@color/dexter_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Explore dedicated pages for all 16 SQLite segments: Tasks, Goals, Schedule, Alarms, Briefings, Capture, Wellbeing, Finance, CRM, Journal, Knowledge, Audit, Traces, Telemetry, Logs, and Schema."
                    android:textColor="@color/dexter_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Open Dedicated Segments Explorer →"
                    android:textColor="@color/dexter_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (Home, Tasks, Finance, Journal, More) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/dexter_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Nav: Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home tab"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/dexter_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/dexter_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nav: Tasks -->
        <LinearLayout
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Tasks tab"
                app:srcCompat="@drawable/ic_tasks"
                app:tint="@color/dexter_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tasks"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Center Cradle Spacer for Floating Voice Orb FAB -->
        <View
            android:id="@+id/navFabSpacer"
            android:layout_width="68dp"
            android:layout_height="match_parent" />

        <!-- Nav: Finance -->
        <LinearLayout
            android:id="@+id/navFinance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Finance tab"
                app:srcCompat="@drawable/ic_finance"
                app:tint="@color/dexter_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Finance"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Nav: 16 Segments -->
        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="16 Segments tab"
                app:srcCompat="@drawable/ic_segments"
                app:tint="@color/dexter_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="16 Segments"
                android:textColor="@color/dexter_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Central Floating Action Button: Animated Compose Voice Orb -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeVoiceOrbFab"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

</RelativeLayout>
